# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Archivos sensibles de service account (nunca subir a git)
*.json.key
/scripts/*.json

# ─────────────────────────────────────────────────────────────────────────────
# SEGURIDAD: Archivos de variables de entorno — NUNCA subir a git
# Contienen API keys, tokens, credenciales de Firebase Admin, etc.
# Se deben configurar directamente en Vercel Dashboard.
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.preview
.env.preview.local
.env.production
.env.production.local
.env.test
.env.test.local

